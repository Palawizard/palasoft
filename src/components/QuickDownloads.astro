---
import type { SoftwareWithRelease } from '../server/software.ts';
import { downloadPath, softwarePath } from '../server/software.ts';
import IconDownload from './IconDownload.astro';
import ReleaseFacts from './ReleaseFacts.astro';

interface Props {
  items: readonly SoftwareWithRelease[];
}

const { items } = Astro.props;
const offered = items.filter(({ view }) => view.state !== 'none');
---

<section class="quick" aria-labelledby="quick-title">
  <h2 id="quick-title" class="quick-title">téléchargement rapide</h2>
  <ul class="quick-list">
    {
      offered.map(({ entry, view }, index) => {
        const isMod = entry.data.kind === 'minecraft-mod';
        return (
          <li class="enter" style={`--order: ${index}`}>
            <a
              class="tile quick-tile"
              data-tilt
              data-color={entry.data.color}
              href={isMod ? `${softwarePath(entry.id)}#telecharger` : downloadPath(entry.id)}
            >
              <span class="quick-name">{entry.data.name}</span>
              <span class="quick-meta">
                {isMod ? <span>choisir ta version de Minecraft</span> : <ReleaseFacts view={view} />}
                <IconDownload />
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .quick {
    display: grid;
    gap: var(--space-2);
  }

  .quick-title {
    font-size: var(--text-subtitle);
  }

  .quick-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quick-tile {
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 5.5rem;
    height: 100%;
    padding: var(--space-2);
  }

  .quick-name {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .quick-meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-1);
    font-size: var(--text-small);
  }
</style>
