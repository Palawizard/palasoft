---
import type { ReleaseView } from '../lib/catalog.ts';
import { formatDate, formatDownloads, formatSize } from '../lib/format.ts';
import { localeOf, stringsFor } from '../i18n/index.ts';

interface Props {
  view: ReleaseView;
  downloads?: number | undefined;
  showDate?: boolean;
  showSize?: boolean;
}

const { view, downloads, showDate = false, showSize = true } = Astro.props;
const locale = localeOf(Astro);
const t = stringsFor(locale);
const size = view.state === 'ready' && view.installer !== undefined ? formatSize(view.installer.size, locale) : undefined;
const date = view.state === 'ready' && view.release.publishedAt !== null ? formatDate(view.release.publishedAt, locale) : undefined;
---

{
  view.state === 'ready' ? (
    <span class="ticket numbers">
      <span class="ticket-items">
      <span>
        {t.facts.version(view.release.version)}
        {view.release.isBeta && <span class="badge">{t.facts.beta}</span>}
      </span>
      {showSize && size !== undefined && <span>{size}</span>}
      {showDate && date !== undefined && <span>{t.facts.published(date)}</span>}
      {downloads !== undefined && <span>{formatDownloads(downloads, locale)}</span>}
      </span>
    </span>
  ) : view.state === 'none' ? (
    <span class="ticket">{t.facts.none}</span>
  ) : (
    <span class="ticket">{t.facts.unavailable}</span>
  )
}
