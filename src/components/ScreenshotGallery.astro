---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  shots: readonly { src: ImageMetadata; alt: string }[];
}

const { name, shots } = Astro.props;
---

<section class="gallery" aria-labelledby="gallery-title">
  <h2 id="gallery-title" class="gallery-title">{name} en images</h2>
  <ul class="strip" tabindex="0" aria-label={`Captures de ${name}, fais défiler`}>
    {
      shots.map((shot) => (
        <li>
          <figure class="shot frame">
            <Image src={shot.src} alt="" widths={[480, 720, 960]} sizes="(min-width: 64rem) 36rem, 85vw" />
            <figcaption>{shot.alt}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .gallery {
    display: grid;
    gap: var(--space-2);
  }

  .gallery-title {
    font-size: var(--text-subtitle);
  }

  .strip {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-1) var(--space-1) var(--space-3);
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-1);
  }

  .strip li {
    flex: none;
    width: min(36rem, 85vw);
    scroll-snap-align: start;
  }

  .frame figcaption {
    padding: 0.6rem 0.4rem 0.3rem;
    color: #0b2a44;
    font-size: var(--text-small);
    line-height: 1.4;
  }
</style>
