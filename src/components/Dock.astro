---
import type { SoftwareWithRelease } from '../server/software.ts';
import { downloadPath, softwarePath, thanksAttributes } from '../server/software.ts';
import IconChevron from './IconChevron.astro';
import IconDownload from './IconDownload.astro';
import SoftwareIcon from './SoftwareIcon.astro';
import NewBadge from './NewBadge.astro';
import { localeOf, stringsFor } from '../i18n/index.ts';

interface Props {
  items: readonly SoftwareWithRelease[];
}

const { items } = Astro.props;
const offered = items.filter(({ view }) => view.state !== 'none');
const locale = localeOf(Astro);
const t = stringsFor(locale);
---

<section id="logiciels" class="glass glass-still dock" aria-labelledby="dock-title">
  <h2 id="dock-title" class="dock-title">{t.dock.title}</h2>
  <ul class="dock-list">
    {
      offered.map(({ entry, view }) => {
        const isMod = entry.data.kind === 'minecraft-mod';
        return (
          <li>
            <a class="pill" href={isMod ? `${softwarePath(entry.id, locale)}#telecharger` : downloadPath(entry.id)} {...thanksAttributes(entry, view, locale)}>
              <SoftwareIcon entry={entry} size={28} class="dock-icon" />
              <span class="dock-text">
                <span>
                  {!isMod && <span class="visually-hidden">{t.dock.download} </span>}
                  {entry.data.name}
                </span>
                <span class="dock-meta numbers">
                  {view.state === 'ready' ? view.release.version : view.state === 'unavailable' ? t.dock.onGitHub : ''}
                  <NewBadge entry={entry} />
                  {isMod && <span class="visually-hidden">{t.dock.chooseVersion}</span>}
                </span>
              </span>
              {isMod ? (
                <span class="gel-dot gel-dot-aqua">
                  <IconChevron />
                </span>
              ) : (
                <span class="gel-dot">
                  <IconDownload />
                </span>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .dock {
    scroll-margin-top: var(--space-3);
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem 1rem 1rem;
  }

  .dock-title {
    font-size: 1rem;
    font-weight: 700;
  }

  .dock-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dock-list .pill {
    width: 100%;
    padding-right: 0.9rem;
  }

  .dock-list .gel-dot {
    margin-left: auto;
  }

  :global(.dock-icon) {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
  }

  .dock-text {
    display: grid;
    line-height: 1.15;
  }

  .dock-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .dock-meta :global(.badge) {
    font-size: 0.75rem;
    line-height: 1.4;
  }


  @media (max-width: 52rem) {
    .dock-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .dock-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .dock-text {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 0.5rem;
    }
  }
</style>
