---
import type { SoftwareEntry } from '../server/software.ts';
import SoftwareIcon from './SoftwareIcon.astro';

interface Props {
  entry: SoftwareEntry;
  caption: string;
}

const { entry, caption } = Astro.props;
---

<div class="titlebar">
  <SoftwareIcon entry={entry} size={20} class="titlebar-icon" />
  <span class="caption">{caption}</span>
  <span class="caption-buttons" aria-hidden="true">
    <span class="cb"></span>
    <span class="cb"></span>
    <span class="cb cb-close"></span>
  </span>
</div>

<style>
  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-small);
    font-weight: 600;
  }

  :global(.titlebar-icon) {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 4px;
  }

  .caption {
    color: var(--ink-soft);
  }

  .caption-buttons {
    display: flex;
    margin-left: auto;
    overflow: hidden;
    border: 1px solid rgb(11 42 68 / 0.3);
    border-radius: 6px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.7);
  }

  .cb {
    width: 1.75rem;
    height: 1.1rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.85) 0%, rgb(220 236 248 / 0.8) 50%, rgb(190 218 238 / 0.8) 51%, rgb(214 232 246 / 0.85) 100%);
  }

  .cb + .cb {
    border-left: 1px solid rgb(11 42 68 / 0.2);
  }

  .cb-close {
    width: 2.75rem;
    background: linear-gradient(to bottom, #f0a08f 0%, #d9533a 49%, #c23a20 50%, #e0704f 100%);
  }
</style>
