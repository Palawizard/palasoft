---
import type { ReleaseView } from '../lib/catalog.ts';
import { formatSize } from '../lib/format.ts';
import { downloadPath, thanksAttributes, type SoftwareEntry } from '../server/software.ts';
import IconDownload from './IconDownload.astro';
import { localeOf, stringsFor } from '../i18n/index.ts';

interface Props {
  entry: SoftwareEntry;
  view: ReleaseView;
  compact?: boolean;
  showFile?: boolean;
}

const { entry, view, compact = false, showFile = true } = Astro.props;
const installer = view.state === 'ready' ? view.installer : undefined;
const locale = localeOf(Astro);
const t = stringsFor(locale);
---

{
  view.state === 'none' ? (
    <p class="none">{t.download.none}</p>
  ) : (
    <div class="download">
      <a class:list={['gel', { 'gel-small': compact }]} href={downloadPath(entry.id)} {...thanksAttributes(entry, view, locale)}>
        <IconDownload />
        {view.state === 'unavailable' ? t.download.onGitHub : compact ? t.download.short : t.download.named(entry.data.name)}
      </a>
      {showFile && installer !== undefined && (
        <p class="file numbers">
          <span class="visually-hidden">{t.program.file}</span>
          {installer.name} · {formatSize(installer.size, locale)}
        </p>
      )}
    </div>
  )
}

<style>
  .download {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
  }

  .file {
    max-width: 100%;
    color: var(--ink-soft);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }

  .none {
    color: var(--ink-soft);
  }
</style>
