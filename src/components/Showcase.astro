---
import { Image } from 'astro:assets';
import type { SoftwareWithRelease } from '../server/software.ts';
import { softwarePath } from '../server/software.ts';
import DownloadButton from './DownloadButton.astro';
import ReleaseFacts from './ReleaseFacts.astro';
import WindowTitle from './WindowTitle.astro';
import NewBadge from './NewBadge.astro';

interface Props {
  item: SoftwareWithRelease;
}

const { entry, view, downloads } = Astro.props.item;
const screenshot = entry.data.screenshots[0];
---

<article class="glass glass-still showcase rise" data-color={entry.data.color} aria-labelledby="showcase-title">
  <WindowTitle entry={entry} caption={entry.data.name} />
  <div class="body">
    <div class="copy">
      <h2 id="showcase-title" class="name"><a href={softwarePath(entry.id)}>{entry.data.name}</a> <NewBadge entry={entry} /></h2>
      <p class="tagline">{entry.data.tagline}</p>
      <ReleaseFacts view={view} downloads={downloads} showDate />
      <DownloadButton entry={entry} view={view} />
      <a class="more" href={softwarePath(entry.id)}>Voir comment l’installer</a>
    </div>
    {
      screenshot !== undefined && (
        <figure class="shot showcase-shot">
          <Image src={screenshot.src} alt={screenshot.alt} widths={[560, 840, 1120, 1600]} sizes="(min-width: 64rem) 34rem, 92vw" quality={90} loading="eager" />
        </figure>
      )
    }
  </div>
</article>

<style>
  .showcase {
    overflow: hidden;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
  }

  .copy {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .name {
    font-size: var(--text-title);
  }

  .name :global(.badge) {
    vertical-align: 0.35em;
  }

  .name a {
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .name a:hover {
      text-decoration: underline;
    }
  }

  .tagline {
    font-size: var(--text-lead);
    line-height: 1.4;
  }

  .more {
    font-weight: 600;
  }

  .showcase-shot {
    transform: perspective(80rem) rotateY(-4deg);
    transform-origin: left center;
  }

  @media (max-width: 56rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .showcase-shot {
      transform: none;
    }
  }
</style>
