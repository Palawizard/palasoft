---
import { Image } from 'astro:assets';
import type { SoftwareWithRelease } from '../server/software.ts';
import { softwarePath } from '../server/software.ts';
import DownloadButton from './DownloadButton.astro';
import ReleaseFacts from './ReleaseFacts.astro';
import SoftwareIcon from './SoftwareIcon.astro';

interface Props {
  item: SoftwareWithRelease;
}

const { entry, view, downloads } = Astro.props.item;
const screenshot = entry.data.screenshots[0];
---

<article class="glass showcase rise" data-color={entry.data.color} aria-labelledby="showcase-title">
  <header class="titlebar">
    <SoftwareIcon entry={entry} size={24} class="titlebar-icon" />
    <span>{entry.data.name}</span>
  </header>
  <div class="body">
    <div class="copy">
      <h2 id="showcase-title" class="name">{entry.data.name}</h2>
      <p class="tagline">{entry.data.tagline}</p>
      <ReleaseFacts view={view} downloads={downloads} showSize={false} />
      <DownloadButton entry={entry} view={view} />
      <a class="more" href={softwarePath(entry.id)}>Voir comment l’installer</a>
    </div>
    {
      screenshot !== undefined && (
        <figure class="shot showcase-shot">
          <Image src={screenshot.src} alt={screenshot.alt} widths={[480, 720, 960]} sizes="(min-width: 64rem) 34rem, 92vw" loading="eager" />
        </figure>
      )
    }
  </div>
</article>

<style>
  .showcase {
    overflow: hidden;
  }


  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-small);
    font-weight: 600;
  }

  :global(.titlebar-icon) {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 4px;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
  }

  .copy {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .name {
    font-size: var(--text-title);
  }

  .tagline {
    font-size: var(--text-lead);
    line-height: 1.4;
  }

  .more {
    font-weight: 600;
  }

  .showcase-shot {
    transform: perspective(80rem) rotateY(-4deg);
    transform-origin: left center;
  }

  @media (max-width: 56rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .showcase-shot {
      transform: none;
    }
  }
</style>
