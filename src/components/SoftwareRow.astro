---
import { Image } from 'astro:assets';
import type { SoftwareWithRelease } from '../server/software.ts';
import { localText, softwarePath } from '../server/software.ts';
import { localeOf, stringsFor } from '../i18n/index.ts';
import DownloadButton from './DownloadButton.astro';
import LanguageBadge from './LanguageBadge.astro';
import ReleaseFacts from './ReleaseFacts.astro';
import { formatSize } from '../lib/format.ts';
import SoftwareIcon from './SoftwareIcon.astro';

export type RowLayout = 'overlap' | 'overlap-flip' | 'compact';

interface Props {
  item: SoftwareWithRelease;
  layout: RowLayout;
}

const { item, layout } = Astro.props;
const { entry, view, downloads } = item;
const locale = localeOf(Astro);
const t = stringsFor(locale);
const text = await localText(entry, locale);
const screenshot = text.screenshots[0];
const installer = view.state === 'ready' ? view.installer : undefined;
const isMod = entry.data.kind === 'minecraft-mod';
---

<li>
  <article class:list={['glass', 'row', layout]} data-color={entry.data.color} aria-labelledby={`row-${entry.id}`}>
    <div class="row-copy">
      <div class="row-head">
        <SoftwareIcon entry={entry} size={56} class="row-icon" />
        <div>
          <h3 id={`row-${entry.id}`} class="row-name">
            <a href={softwarePath(entry.id, locale)}>{entry.data.name}</a>
          </h3>
          <p class="row-kind">{isMod ? t.program.forServer : t.program.forWindows} <LanguageBadge entry={entry} /></p>
        </div>
      </div>
      <p class="row-tagline">{text.tagline}</p>
      <ReleaseFacts view={view} downloads={downloads} showDate />
      <div class="row-actions">
        {
          isMod ? (
            <a class="gel gel-small" href={`${softwarePath(entry.id, locale)}#telecharger`}>
              {t.program.chooseVersion}
            </a>
          ) : (
            <DownloadButton entry={entry} view={view} compact showFile={false} />
          )
        }
        <a class="gel gel-aqua gel-small" href={softwarePath(entry.id, locale)}>
          {t.program.installHelp}
        </a>
      </div>
      {installer !== undefined && (
        <p class="row-file numbers">
          <span class="visually-hidden">{t.program.file}</span>
          {installer.name} · {formatSize(installer.size, locale)}
        </p>
      )}
    </div>
    <div class="row-media">
      {
        screenshot !== undefined ? (
          <figure class="shot">
            <Image
              src={screenshot.src}
              alt={screenshot.alt}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 64rem) 38rem, 92vw"
              quality={90}
            />
          </figure>
        ) : (
          <div class="no-shot">
            <SoftwareIcon entry={entry} size={120} class="no-shot-icon" />
            <p>{t.program.noShot}</p>
          </div>
        )
      }
    </div>
  </article>
</li>

<style>
  .row {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
  }

  .row-copy {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .row-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  :global(.row-icon) {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgb(6 48 74 / 0.3);
  }

  .row-name {
    font-size: var(--text-title);
  }

  .row-name a {
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .row-name a:hover {
      text-decoration: underline;
    }
  }

  .row-kind {
    color: var(--ink-soft);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .row-tagline {
    max-width: 36ch;
    font-size: var(--text-lead);
    line-height: 1.4;
  }

  .row-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .row-file {
    color: var(--ink-soft);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }

  .row-media {
    display: grid;
    justify-items: center;
  }

  .overlap,
  .overlap-flip {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr);
    margin-block: var(--space-4);
  }

  .overlap .row-media .shot {
    margin: calc(var(--space-8) * -1) calc(var(--space-6) * -1) calc(var(--space-8) * -1) 0;
    transform: perspective(90rem) rotateY(-5deg);
    transform-origin: left center;
  }

  .overlap-flip {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.9fr);
  }

  .overlap-flip .row-copy {
    order: 2;
  }

  .overlap-flip .row-media .shot {
    margin: calc(var(--space-8) * -1) 0 calc(var(--space-8) * -1) calc(var(--space-6) * -1);
    transform: perspective(90rem) rotateY(5deg);
    transform-origin: right center;
  }

  .compact {
    grid-template-columns: auto minmax(0, 1fr);
    max-width: 58rem;
    padding: var(--space-3);
  }

  .compact .row-media {
    order: -1;
  }

  .compact .row-media .shot {
    width: fit-content;
    transform: rotate(-2deg);
  }

  .compact .row-media .shot :global(img) {
    width: auto;
    max-height: 15rem;
  }

  .no-shot {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-3);
    border: 1px dashed var(--rule);
    border-radius: 10px;
    color: var(--ink-soft);
    text-align: center;
  }

  :global(.no-shot-icon) {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 24px;
    box-shadow: 0 10px 24px rgb(6 48 74 / 0.3);
  }

  @media (max-width: 56rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .row {
      margin-block: 0;
      padding: var(--space-3);
    }

    .row .row-media {
      order: -1;
    }


    .row .row-media .shot {
      margin: calc(var(--space-6) * -1) 0 0;
      transform: none;
    }

    .compact {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }

    .compact .row-media .shot {
      margin: 0;
    }

    .compact .row-media .shot :global(img) {
      max-height: 9rem;
    }
  }

  @media (max-width: 30rem) {
    .compact {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
