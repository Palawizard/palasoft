---
import { localeOf, stringsFor } from '../../i18n/index.ts';

// How Chest Counter builds its total, with the figures of the example window shown on the page.
const b = stringsFor(localeOf(Astro)).chestCounter.breakdown;
---

<section class="glass breakdown" data-color="amber" aria-labelledby="breakdown-title">
  <div class="intro">
    <h2 id="breakdown-title">{b.title}</h2>
    <p>{b.intro}</p>
    <p class="example">{b.example}</p>
  </div>

  <dl class="sum numbers">
    <div class="line">
      <dt>{b.read}</dt>
      <dd class="figure">{b.readFigure}</dd>
      <dd class="detail">{b.readDetail}</dd>
    </div>
    <div class="line">
      <dt>{b.estimated}</dt>
      <dd class="figure"><span class="plus" aria-hidden="true">+</span> {b.estimatedFigure}</dd>
      <dd class="detail">{b.estimatedDetail}</dd>
    </div>
    <div class="line total">
      <dt>{b.total}</dt>
      <dd class="figure">{b.totalFigure}</dd>
      <dd class="detail">{b.totalDetail}</dd>
    </div>
  </dl>
</section>

<style>
  .breakdown {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-4);
  }

  .intro {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  h2 {
    font-size: var(--text-subtitle);
  }

  .example {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  .sum {
    display: grid;
    margin: 0;
  }

  .line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-3);
    row-gap: 0.25rem;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--rule);
  }

  .line:first-child {
    padding-top: 0;
  }

  .total {
    padding-bottom: 0;
    border-bottom: 0;
    border-top: 2px solid var(--ink);
  }

  dt {
    font-size: 1.25rem;
    font-weight: 650;
  }

  .figure {
    grid-row: span 2;
    margin: 0;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    text-align: right;
  }

  .total .figure {
    font-size: clamp(2.25rem, 1.6rem + 1.8vw, 3rem);
  }

  .plus {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .detail {
    max-width: 46ch;
    margin: 0;
    color: var(--ink-soft);
  }

  @media (max-width: 56rem) {
    .breakdown {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: var(--space-3);
    }
  }
</style>
