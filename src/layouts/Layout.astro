---
import '../styles/global.css';
import AeroBubbles from '../components/AeroBubbles.astro';
import Logo from '../components/Logo.astro';
import SkyToggle from '../components/SkyToggle.astro';
import DownloadThanks from '../components/DownloadThanks.astro';
import { allSoftware, assetPath, homePath, localizedPath, softwarePath } from '../server/software.ts';
import { localeOf, stringsFor } from '../i18n/index.ts';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { SITE_NAME, serializeJsonLd, type JsonLd } from '../lib/seo.ts';

export interface ShareImage {
  src: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  /** Picture shown when a link to the page is shared (Discord, social networks); the PalaSoft card by default. */
  image?: ShareImage | undefined;
  noindex?: boolean;
  jsonLd?: JsonLd[];
}

const { title, description, image, noindex = false, jsonLd = [] } = Astro.props;
const locale = localeOf(Astro);
const t = stringsFor(locale);
const pagePath = Astro.locals.pagePath ?? '/';
const alternates = [
  { hreflang: 'fr', href: new URL(localizedPath(pagePath, 'fr'), Astro.site).href },
  { hreflang: 'en', href: new URL(localizedPath(pagePath, 'en'), Astro.site).href },
  { hreflang: 'x-default', href: new URL(localizedPath(pagePath, 'fr'), Astro.site).href },
];
const software = await allSoftware();
const mod = software.find((entry) => entry.data.kind === 'minecraft-mod');
const canonical = new URL(Astro.url.pathname, Astro.site);
const share: ShareImage = image ?? {
  src: assetPath('og-palasoft.jpg?v=2'),
  width: 1200,
  height: 630,
  alt: t.layout.shareAlt,
};
const shareUrl = new URL(share.src, Astro.site).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    {jsonLd.length > 0 && <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />}
    <link rel="icon" href={assetPath('favicon.svg?v=2')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={assetPath('apple-touch-icon.png?v=2')} />
    <meta name="theme-color" content="#0b4fa3" />
    <script is:inline>
      (() => {
        let choice = null;
        try {
          choice = localStorage.getItem('palasoft-theme');
        } catch {}
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = choice === 'light' || choice === 'dark' ? choice : system;
        document.documentElement.dataset.theme = theme;
        if (theme === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#050d1f');
      })();
    </script>
  </head>
  <body>
    <AeroBubbles />
    <SkyToggle />
    <a class="skip" href="#contenu">{t.layout.skip}</a>
    <header class="page site-header">
      <nav class="glass bar" aria-label={t.layout.navLabel}>
        <div class="brand">
          <a class="pill back-home" href="https://palawi.fr/" title={t.layout.backHome} hreflang="fr">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            palawi.fr
          </a>
          <a class="wordmark" href={homePath(locale)}>
            <Logo class="logo" />
            PalaSoft
          </a>
        </div>
        <ul class="nav">
          <li><a href={`${homePath(locale)}#logiciels`}>{t.layout.allSoftware}</a></li>
          {mod !== undefined && <li><a href={softwarePath(mod.id, locale)}>{t.layout.minecraftMod}</a></li>}
          <li class="nav-language"><LanguageSwitch /></li>
        </ul>
      </nav>
    </header>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <footer class="page site-footer">
      <div class="glass footer-panel">
        <div>
          <p class="footer-title">PalaSoft</p>
          <p>{t.layout.footerTagline} <a href="https://palawi.fr">palawi.fr</a></p>
        </div>
        <nav aria-labelledby="code-title">
          <p class="footer-title" id="code-title">{t.layout.footerCode}</p>
          <ul class="footer-links">
            {
              software.map((entry) => (
                <li>
                  <a href={`https://github.com/${entry.data.repo}`}>{entry.data.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </footer>
    <DownloadThanks />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: var(--space-1);
    left: var(--space-1);
    z-index: 10;
    padding: var(--space-1) var(--space-2);
    border-radius: 8px;
    background: var(--glass-strong);
    color: var(--ink);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  .site-header {
    padding-top: var(--space-2);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding: 0.6rem 1rem 0.6rem 0.75rem;
  }

  /* The way back to Palawi's hub, then PalaSoft's own name. */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .back-home {
    gap: 0.35rem;
    min-height: 2.5rem;
    padding: 0.3rem 0.9rem 0.3rem 0.6rem;
    font-size: var(--text-small);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .wordmark :global(.logo) {
    width: 2rem;
    height: 2rem;
    filter: drop-shadow(0 2px 3px rgb(6 48 74 / 0.3));
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .nav a {
    display: inline-block;
    padding-block: 0.4rem;
    text-decoration: none;
  }

  /* On a phone the links take the second row, with the language switch at its end. */
  @media (max-width: 40rem) {
    .nav {
      flex: 1 1 100%;
      column-gap: var(--space-2);
    }

    .nav-language {
      margin-inline-start: auto;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      text-decoration: underline;
    }
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    margin-top: var(--space-12);
    padding-bottom: var(--space-4);
  }

  .footer-panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
    padding: var(--space-4);
    font-size: var(--text-small);
  }

  .footer-title {
    margin-bottom: var(--space-1);
    font-weight: 700;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-block;
    padding-block: 0.4rem;
  }
</style>
