---
import type { SoftwareEntry } from '../server/software.ts';
import { localeOf, stringsFor } from '../i18n/index.ts';

// On the English site, tells which programs have an English interface (`languages` in the content).
interface Props {
  entry: SoftwareEntry;
}

const { entry } = Astro.props;
const locale = localeOf(Astro);
const shown = locale === 'en' && entry.data.languages.includes('en');
const t = stringsFor(locale);
---

{
  shown && (
    <span class="language-badge">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      </svg>
      {t.program.inEnglish}
    </span>
  )
}

<style>
  .language-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0 0.6em 0 0.45em;
    border: 1px solid rgb(31 111 176 / 0.35);
    border-radius: var(--radius-control);
    background: linear-gradient(to bottom, var(--pill-0) 0%, var(--pill-1) 50%, var(--pill-2) 51%, var(--pill-1) 100%);
    color: var(--gel-aqua-2);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.6;
    vertical-align: 0.1em;
    white-space: nowrap;
  }

  .language-badge svg {
    flex: none;
  }

  :global(:root[data-theme='dark']) .language-badge {
    border-color: rgb(170 214 255 / 0.35);
    background: linear-gradient(to bottom, var(--pill-0) 0%, var(--pill-1) 50%, var(--pill-2) 51%, var(--pill-1) 100%);
    color: #bfe3ff;
  }
</style>
