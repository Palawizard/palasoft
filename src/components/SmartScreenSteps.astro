---
import { localeOf, stringsFor } from '../i18n/index.ts';

// What to do when Windows SmartScreen warns about an unsigned installer: on the program page and in the thank-you window.
const t = stringsFor(localeOf(Astro));
---

<div class="steps">
  <p>{t.smartscreen.intro}</p>
  <ol>
    {t.smartscreen.steps.map((step) => <li>{step}</li>)}
  </ol>
  <p class="note">{t.smartscreen.note}</p>
</div>

<style>
  .steps {
    display: grid;
    gap: var(--space-2);
  }

  ol {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding-left: 1.4em;
  }

  .note {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }
</style>
