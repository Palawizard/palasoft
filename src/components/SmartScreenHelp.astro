---
import SmartScreenSteps from './SmartScreenSteps.astro';
---

<section class="glass smartscreen" aria-labelledby="smartscreen-title">
  <header class="dialog-bar">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M12 2 3 5.5v6c0 5 3.8 9.3 9 10.5 5.2-1.2 9-5.5 9-10.5v-6L12 2Z" fill="#2c86c9" />
      <path d="M12 7v6M12 16v.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
    </svg>
    <h2 id="smartscreen-title">Si Windows t’avertit</h2>
  </header>
  <div class="dialog-body">
    <SmartScreenSteps />
  </div>
</section>

<style>
  .smartscreen {
    overflow: hidden;
  }

  .dialog-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  h2 {
    font-size: 1.25rem;
  }

  .dialog-body {
    padding: var(--space-3);
  }
</style>
