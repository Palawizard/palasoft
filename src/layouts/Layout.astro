---
import '../styles/global.css';
import { allSoftware, homePath } from '../server/software.ts';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const software = await allSoftware();
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site-header page">
      <a class="wordmark" href={homePath}>PalaSoft</a>
      <p class="byline">les logiciels de Palawi</p>
    </header>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page footer-grid">
        <div>
          <p class="footer-title">PalaSoft</p>
          <p>
            Fait par Palawi. Son site : <a href="https://palawi.fr">palawi.fr</a>
          </p>
        </div>
        <nav aria-labelledby="code-title">
          <p class="footer-title" id="code-title">Le code de chaque logiciel</p>
          <ul class="footer-links">
            {
              software.map((entry) => (
                <li>
                  <a href={`https://github.com/${entry.data.repo}`}>{entry.data.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import { enableTileTilt } from '../scripts/tilt.ts';
      enableTileTilt(document);
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: var(--space-1);
    left: var(--space-1);
    z-index: 10;
    padding: var(--space-1) var(--space-2);
    background: var(--brand);
    color: var(--on-brand);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-3);
  }

  .wordmark {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .byline {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    margin-top: var(--space-12);
    padding-block: var(--space-6);
    border-top: 1px solid var(--rule);
    font-size: var(--text-small);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  .footer-title {
    margin-bottom: var(--space-1);
    font-weight: 600;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-block;
    padding-block: var(--space-1);
  }
</style>
