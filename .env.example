# Address the Node server listens on
HOST=0.0.0.0
PORT=4321

# GitHub token with read access to public repositories (raises the API rate limit)
GITHUB_TOKEN=

# CurseForge API key, used to read the download count of the Minecraft mods
CURSEFORGE_API_KEY=

# Folder where the server keeps its last known release snapshot
DATA_DIR=./data

# Docker network shared with the reverse proxy (compose.yaml)
PALASOFT_NETWORK=palasoft-edge
