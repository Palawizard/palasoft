---
import type { ReleaseView } from '../lib/catalog.ts';
import { downloadPath, type SoftwareEntry } from '../server/software.ts';
import IconDownload from './IconDownload.astro';
import ReleaseFacts from './ReleaseFacts.astro';

interface Props {
  entry: SoftwareEntry;
  view: ReleaseView;
}

const { entry, view } = Astro.props;
---

<div class="download">
  {
    view.state === 'none' ? (
      <p class="none">Aucune version n'est publiée pour l'instant.</p>
    ) : (
      <a class="tile download-tile" data-tilt data-color={entry.data.color} href={downloadPath(entry.id)}>
        <span class="download-action">
          <IconDownload />
          {view.state === 'unavailable' ? `Télécharger ${entry.data.name} sur GitHub` : `Télécharger ${entry.data.name}`}
        </span>
        <span class="download-facts">
          <ReleaseFacts view={view} showDate />
        </span>
      </a>
    )
  }
  <p class="download-note">Pour Windows. Fichier hébergé sur GitHub, le site de code où Palawi publie ses logiciels.</p>
</div>

<style>
  .download {
    display: grid;
    gap: var(--space-1);
    justify-items: start;
  }

  .download-tile {
    gap: var(--space-2);
    min-width: min(100%, 26rem);
    padding: var(--space-3);
  }

  .download-action {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .download-facts {
    font-size: var(--text-small);
  }

  .download-note,
  .none {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  .none {
    font-size: var(--text-body);
  }
</style>
