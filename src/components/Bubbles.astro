---
import type { SoftwareWithRelease } from '../server/software.ts';
import { softwarePath } from '../server/software.ts';
import SoftwareIcon from './SoftwareIcon.astro';

interface Props {
  items: readonly SoftwareWithRelease[];
}

const { items } = Astro.props;
---

<nav class="bubbles" aria-label="Les autres logiciels">
  <ul>
    {
      items.map(({ entry }, index) => (
        <li class="rise" style={`--order:${index + 2}`}>
          <a class="bubble" data-color={entry.data.color} href={softwarePath(entry.id)} style={`animation-delay:-${index * 1.3}s`}>
            <span class="sphere">
              <SoftwareIcon entry={entry} size={56} class="bubble-icon" />
            </span>
            <span class="label">{entry.data.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li:nth-child(even) {
    margin-top: var(--space-6);
  }

  .bubble {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
    text-decoration: none;
    animation: drift 5s ease-in-out infinite alternate;
  }

  .sphere {
    position: relative;
    display: grid;
    place-items: center;
    width: 7.5rem;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 50%;
    background:
      radial-gradient(circle at 34% 24%, rgb(255 255 255 / 0.95) 0 9%, rgb(255 255 255 / 0.2) 26%, transparent 46%),
      radial-gradient(circle at 50% 60%, color-mix(in srgb, var(--tint) 35%, rgb(255 255 255 / 0.5)) 0, color-mix(in srgb, var(--tint) 55%, rgb(20 90 160 / 0.4)) 100%);
    box-shadow: inset 0 -6px 14px rgb(255 255 255 / 0.35), 0 14px 26px -10px rgb(6 48 74 / 0.55);
    transition: transform 200ms var(--ease-out);
  }

  .sphere::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 50% 30%, rgb(255 255 255 / 0.45), transparent 60%);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  :global(.bubble-icon) {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgb(6 48 74 / 0.35);
  }

  .label {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-control);
    background: var(--glass-strong);
    box-shadow: 0 2px 6px -2px rgb(6 48 74 / 0.35);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.3;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .bubble:hover .sphere {
      transform: scale(1.05);
    }

    .bubble:hover .sphere::after {
      opacity: 1;
    }
  }

  @media (max-width: 64rem) {
    ul {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      padding-bottom: var(--space-1);
      scroll-snap-type: x mandatory;
    }

    li {
      flex: none;
      scroll-snap-align: start;
    }

    li:nth-child(even) {
      margin-top: 0;
    }

    .sphere {
      width: 5.5rem;
    }

    :global(.bubble-icon) {
      width: 2.75rem;
      height: 2.75rem;
    }

    .label {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
    }

    .sphere {
      transition: none;
    }
  }
</style>
