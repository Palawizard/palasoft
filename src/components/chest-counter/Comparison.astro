---
import { localeOf, stringsFor } from '../../i18n/index.ts';

// Chest Counter against the other kinds of chest counters, as checked in November 2026 (same table as
// the README of Chest Counter). The verdict of each cell stays here; the words come from the
// dictionaries, in the same order.
type Verdict = 'yes' | 'no' | 'partial';
const c = stringsFor(localeOf(Astro)).chestCounter.comparison;
const verdicts: Verdict[][] = [
  ['yes', 'yes', 'no', 'yes'],
  ['yes', 'yes', 'partial', 'no'],
  ['yes', 'yes', 'yes', 'no'],
  ['yes', 'no', 'no', 'yes'],
];
const rows = c.rows.map((row, index) => ({
  label: row.label,
  answers: row.answers.map((text, column) => ({ text, verdict: verdicts[index]?.[column] ?? 'partial' })),
}));
---

<section class="glass comparison" aria-labelledby="comparison-title">
  <h2 id="comparison-title">{c.title}</h2>
  <div class="scroll" role="region" aria-labelledby="comparison-title" tabindex="0">
    <table>
      <thead>
        <tr>
          <td></td>
          {c.columns.map((column) => <th scope="col">{column}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.answers.map((answer, column) => (
                <td class={answer.verdict} data-column={c.columns[column]}>
                  <span class="answer">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                      {answer.verdict === 'yes' ? (
                        <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                      ) : answer.verdict === 'no' ? (
                        <path d="M7 7l10 10M17 7 7 17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                      ) : (
                        <path d="M6 12h12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                      )}
                    </svg>
                    {answer.text}
                  </span>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="as-of">{c.asOf}</p>
</section>

<style>
  .comparison {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  h2 {
    font-size: var(--text-subtitle);
  }

  .scroll {
    overflow-x: auto;
    margin-top: var(--space-1);
    border-radius: 10px;
  }

  table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.7rem var(--space-2);
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    font-size: var(--text-small);
    font-weight: 650;
    color: var(--ink-soft);
  }

  thead th:first-of-type {
    color: var(--ink);
    font-size: 1.0625rem;
  }

  tbody th {
    width: 11rem;
    font-weight: 600;
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  .answer {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.4rem;
    color: var(--ink-soft);
  }

  .answer svg {
    flex: none;
    margin-top: 0.15rem;
  }

  .yes .answer {
    color: var(--ink);
    font-weight: 600;
  }

  .yes .answer svg {
    color: var(--gel-green-1);
  }

  /* The Chest Counter column, lit by the program's tint. */
  thead th:first-of-type,
  tbody td:nth-child(2) {
    background: color-mix(in srgb, var(--tint-amber) 18%, rgb(255 255 255 / 0.6));
  }

  :global(:root[data-theme='dark']) thead th:first-of-type,
  :global(:root[data-theme='dark']) tbody td:nth-child(2) {
    background: color-mix(in srgb, var(--tint-amber) 20%, transparent);
  }

  .as-of {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  /* On a phone, five columns would only scroll sideways: each criterion becomes a short list where
     every answer carries the name of its column. */
  @media (max-width: 40rem) {
    .comparison {
      padding: var(--space-3) var(--space-2);
    }

    .scroll {
      overflow: visible;
    }

    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    table {
      min-width: 0;
    }

    thead {
      display: none;
    }

    tbody tr {
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--rule);
    }

    tbody tr:last-child {
      border-bottom: 0;
    }

    tbody th,
    tbody td {
      width: auto;
      padding: 0.3rem 0.5rem;
      border-bottom: 0;
    }

    tbody th {
      padding-bottom: 0.4rem;
      font-size: 1.0625rem;
      font-weight: 700;
    }

    tbody td {
      display: grid;
      grid-template-columns: 8.5rem 1fr;
      gap: 0.75rem;
      border-radius: 8px;
    }

    tbody td::before {
      content: attr(data-column);
      color: var(--ink-soft);
      font-size: var(--text-small);
      font-weight: 650;
      line-height: 1.5;
    }
  }

  :global(:root[data-theme='dark']) .yes .answer svg {
    color: var(--gel-green-0);
  }
</style>
