---
import type { SoftwareWithRelease } from '../server/software.ts';
import { softwarePath } from '../server/software.ts';
import ReleaseFacts from './ReleaseFacts.astro';

interface Props {
  item: SoftwareWithRelease;
  order: number;
}

const { item, order } = Astro.props;
const { entry, view } = item;
---

<li class="enter" style={`--order: ${order}`}>
  <a class="tile software-tile" data-tilt data-color={entry.data.color} href={softwarePath(entry.id)}>
    <h3 class="software-name">{entry.data.name}</h3>
    <p class="software-tagline">{entry.data.tagline}</p>
    <p class="software-facts">
      <span>{entry.data.kind === 'minecraft-mod' ? 'mod Minecraft pour serveur' : 'pour Windows'}</span>
      <ReleaseFacts view={view} />
    </p>
  </a>
</li>

<style>
  .software-tile {
    gap: var(--space-2);
    min-height: 15rem;
    height: 100%;
    padding: var(--space-3);
  }

  .software-name {
    font-size: var(--text-title);
  }

  .software-tagline {
    flex: 1;
    max-width: 34ch;
  }

  .software-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: var(--text-small);
  }
</style>
