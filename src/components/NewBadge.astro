---
import type { SoftwareEntry } from '../server/software.ts';

interface Props {
  entry: SoftwareEntry;
}

const { newUntil } = Astro.props.entry.data;
// Pages render on each request, so the badge goes away on its own once the date has passed.
const isNew = newUntil !== undefined && Date.now() < newUntil.getTime();
---

{isNew && <span class="badge">Nouveau</span>}
