---
import Layout from '../layouts/Layout.astro';
import { homePath } from '../server/software.ts';
import { localeOf, stringsFor } from '../i18n/index.ts';

// One page for both languages: an address under /en gets the English text.
const locale = localeOf(Astro);
const t = stringsFor(locale);
---

<Layout title={`${t.notFound.title} | PalaSoft`} description={t.notFound.description} noindex>
  <section class="page lost">
    <div class="glass window rise">
      <h1>{t.notFound.title}</h1>
      <p>{t.notFound.text}</p>
      <a class="gel gel-aqua" href={homePath(locale)}>{t.notFound.back}</a>
    </div>
  </section>
</Layout>
<style>
  .lost {
    padding-block: var(--space-8);
  }

  .window {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    max-width: 36rem;
    padding: var(--space-6) var(--space-4);
  }

  h1 {
    font-size: var(--text-display);
  }
</style>
