---
import type { SoftwareEntry } from '../server/software.ts';
import SoftwareIcon from './SoftwareIcon.astro';

interface Props {
  entry: SoftwareEntry;
  caption: string;
}

const { entry, caption } = Astro.props;
---

<div class="titlebar">
  <SoftwareIcon entry={entry} size={20} class="titlebar-icon" />
  <span class="caption">{caption}</span>
  <span class="caption-buttons" aria-hidden="true">
    <span class="cb">
      <svg viewBox="0 0 12 10" width="12" height="10"><rect x="2" y="6" width="8" height="2.4" rx="0.5" /></svg>
    </span>
    <span class="cb">
      <svg viewBox="0 0 12 10" width="12" height="10"><path d="M2 1.5h8v7H2z M3.4 3.6v3.5h5.2V3.6z" fill-rule="evenodd" /></svg>
    </span>
    <span class="cb cb-close">
      <svg viewBox="0 0 12 10" width="12" height="10"><path d="M2.6 1.2 6 4 9.4 1.2l1.2 1.2L7.4 5l3.2 2.6-1.2 1.2L6 6 2.6 8.8 1.4 7.6 4.6 5 1.4 2.4z" /></svg>
    </span>
  </span>
</div>

<style>
  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-small);
    font-weight: 600;
  }

  :global(.titlebar-icon) {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 4px;
  }

  .caption {
    color: var(--ink-soft);
  }

  .caption-buttons {
    display: flex;
    margin-left: auto;
    border-radius: 5px;
    box-shadow:
      0 0 0 1px rgb(11 42 68 / 0.45),
      0 1px 0 1px rgb(255 255 255 / 0.5),
      0 2px 4px -1px rgb(6 48 74 / 0.35);
  }

  .cb {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.15rem;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.95) 0%,
      rgb(226 238 248 / 0.95) 45%,
      rgb(180 205 228 / 0.95) 50%,
      rgb(205 225 243 / 0.95) 100%
    );
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .cb + .cb {
    border-left: 1px solid rgb(11 42 68 / 0.35);
  }

  .cb:first-child {
    border-radius: 5px 0 0 5px;
  }

  .cb svg {
    width: 0.75rem;
    height: auto;
    fill: #ffffff;
    filter: drop-shadow(0 0 0.6px rgb(11 30 50 / 0.95)) drop-shadow(0 1px 0.5px rgb(11 30 50 / 0.5));
  }

  .cb-close {
    width: 2.6rem;
    border-radius: 0 5px 5px 0;
    background: linear-gradient(
      to bottom,
      #f3b7a8 0%,
      #e3735a 45%,
      #c8401f 50%,
      #dd6a44 85%,
      #f0a27f 100%
    );
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6), inset 0 0 0 1px rgb(255 255 255 / 0.2);
  }

  .cb-close svg {
    filter: drop-shadow(0 0 0.6px rgb(90 15 0 / 0.95)) drop-shadow(0 1px 0.5px rgb(90 15 0 / 0.5));
  }

  :global(:root[data-theme='dark']) .cb:not(.cb-close) {
    background: linear-gradient(
      to bottom,
      rgb(120 160 205 / 0.55) 0%,
      rgb(70 110 160 / 0.55) 45%,
      rgb(40 75 120 / 0.6) 50%,
      rgb(60 100 150 / 0.55) 100%
    );
    box-shadow: inset 0 1px 0 rgb(200 225 255 / 0.4);
  }
</style>
