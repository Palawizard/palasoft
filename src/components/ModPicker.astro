---
import { filesByLoader } from '../lib/assets.ts';
import type { ReleaseView } from '../lib/catalog.ts';
import { formatDate, formatSize, loaderName, minecraftBandLabel } from '../lib/format.ts';
import { downloadPath, type SoftwareEntry } from '../server/software.ts';
import IconDownload from './IconDownload.astro';
import CompanionMods from './CompanionMods.astro';
import { modCompanions } from '../server/dependencies.ts';
import { localeOf, stringsFor } from '../i18n/index.ts';

interface Props {
  entry: SoftwareEntry;
  view: ReleaseView;
}

const { entry, view } = Astro.props;
const groups = view.state === 'ready' ? filesByLoader(view.modFiles) : [];
const locale = localeOf(Astro);
const t = stringsFor(locale);
const companions = await modCompanions(entry, view);
const stores =
  entry.data.kind === 'minecraft-mod'
    ? [
        { label: 'Modrinth', url: entry.data.modrinth },
        { label: 'CurseForge', url: entry.data.curseforge },
      ]
    : [];
---

<div class="picker">
  {
    view.state === 'ready' && groups.length > 0 ? (
      <form class="picker-form" method="get" action={downloadPath(entry.id)} data-thanks={entry.data.name} data-thanks-kind="mod">
        <input type="hidden" name="lang" value={locale} />
        <fieldset class="loaders">
          <legend>{t.mod.loader}</legend>
          <div class="loader-options">
            {groups.map(({ loader }) => (
              <label class="loader-option">
                <input type="radio" name="loader" value={loader} required />
                <span>{loaderName(loader)}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="versions">
          <p class="step">{t.mod.minecraft}</p>
          <p class="hint">{t.mod.loaderFirst}</p>
          {groups.map(({ loader, files }) => (
            <label class="version-field" data-loader={loader}>
              <span class="visually-hidden">{t.mod.versionFor(loaderName(loader))}</span>
              <select name={`mc-${loader}`}>
                {files.map((file) => (
                  <option value={file.bandId} data-file={`${file.asset.name} · ${formatSize(file.asset.size, locale)}`}>
                    {t.mod.option(minecraftBandLabel(file.bandId, locale))}
                  </option>
                ))}
              </select>
            </label>
          ))}
        </div>
        <button class="gel submit" type="submit">
          <span class="submit-action">
            <IconDownload />
            {t.mod.download}
          </span>
          <span class="submit-facts numbers ready-facts">
            {t.facts.version(view.release.version)}
            {view.release.publishedAt !== null && ` · ${t.facts.published(formatDate(view.release.publishedAt, locale))}`}
          </span>
          <span class="submit-facts numbers file-facts" data-file-facts></span>
          <span class="submit-facts waiting-facts" aria-hidden="true">
            {t.mod.waiting}
          </span>
        </button>
        {companions.map((band) => (
          <CompanionMods band={band} />
        ))}
      </form>
    ) : view.state === 'none' ? (
      <p>{t.download.none}</p>
    ) : (
      <p>
        {t.mod.unavailableBefore} <a href={`${view.historyUrl}/latest`}>{t.mod.unavailableLink}</a>
        {t.mod.unavailableAfter}
      </p>
    )
  }
  <p class="server-only">
    {t.mod.serverOnly}
  </p>
  <ul class="stores">
    {
      stores.map((store) => (
        <li>
          <a class="pill store" href={store.url}>
            {t.mod.alsoOn(store.label)}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.picker-form')) {
    const target = form.querySelector<HTMLElement>('[data-file-facts]');
    const companions = [...form.querySelectorAll<HTMLElement>('[data-companions]')];
    const update = (): void => {
      const loader = form.querySelector<HTMLInputElement>('input[name="loader"]:checked')?.value;
      const select = loader === undefined ? null : form.querySelector<HTMLSelectElement>(`select[name="mc-${loader}"]`);
      const file = select?.selectedOptions[0]?.dataset['file'];
      // The mods to add for this choice show under the button (and in the thank-you window).
      for (const block of companions) {
        block.hidden = block.dataset['loader'] !== loader || block.dataset['band'] !== select?.value;
      }
      if (target === null) return;
      target.textContent = file ?? '';
      form.classList.toggle('has-file', file !== undefined);
    };
    form.addEventListener('change', update);
    update();
  }
</script>

<style>
  .picker {
    display: grid;
    gap: var(--space-3);
  }

  .picker-form {
    display: grid;
    gap: var(--space-3);
  }

  .loaders {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend,
  .step {
    margin-bottom: var(--space-1);
    padding: 0;
    font-weight: 700;
  }

  .loader-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgb(11 42 68 / 0.25);
    border-radius: var(--radius-control);
    box-shadow: 0 3px 8px -3px rgb(6 48 74 / 0.35);
  }

  .loader-option {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .loader-option + .loader-option {
    border-left: 1px solid rgb(11 42 68 / 0.18);
  }

  .loader-option input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .loader-option span {
    display: block;
    padding: 0.6rem 0.4rem;
    background: linear-gradient(to bottom, var(--pill-0) 0%, var(--pill-1) 50%, var(--pill-2) 51%, var(--pill-1) 100%);
    font-weight: 600;
    text-align: center;
  }

  .loader-option input:checked + span {
    background: linear-gradient(to bottom, var(--gel-aqua-0) 0%, var(--gel-aqua-1) 49%, var(--gel-aqua-2) 50%, var(--gel-aqua-3) 100%);
    color: #ffffff;
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.4);
  }

  .loader-option input:focus-visible + span {
    outline: 3px solid var(--gel-aqua-1);
    outline-offset: -3px;
  }

  .versions {
    display: grid;
    gap: var(--space-1);
  }

  .hint {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(11 42 68 / 0.25);
    border-radius: 10px;
    background: var(--glass-strong);
    box-shadow: inset 0 2px 4px rgb(6 48 74 / 0.12);
    color: var(--ink);
    font: inherit;
  }

  .submit {
    display: grid;
    justify-items: start;
    gap: 0.2rem;
    width: 100%;
    border-radius: 18px;
    text-align: left;
  }

  .submit-action {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .submit-facts {
    font-size: var(--text-small);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .file-facts:empty {
    display: none;
  }

  .has-file .ready-facts {
    display: none;
  }

  @supports selector(:has(*)) {
    .version-field {
      display: none;
    }

    .picker-form:has(input[value='fabric']:checked) .version-field[data-loader='fabric'],
    .picker-form:has(input[value='forge']:checked) .version-field[data-loader='forge'],
    .picker-form:has(input[value='neoforge']:checked) .version-field[data-loader='neoforge'] {
      display: block;
    }

    .picker-form:has(input[name='loader']:checked) .hint {
      display: none;
    }

    .waiting-facts {
      display: none;
    }

    .picker-form:not(:has(input[name='loader']:checked)) .submit {
      background: var(--glass-strong);
      border-color: rgb(11 42 68 / 0.3);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6);
      color: var(--ink);
      text-shadow: none;
    }

    .picker-form:not(:has(input[name='loader']:checked)) .ready-facts {
      display: none;
    }

    .picker-form:not(:has(input[name='loader']:checked)) .waiting-facts {
      display: block;
    }
  }

  @supports not selector(:has(*)) {
    .hint,
    .waiting-facts {
      display: none;
    }
  }

  .server-only {
    font-weight: 700;
  }

  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .store {
    padding-left: 1rem;
  }
</style>
