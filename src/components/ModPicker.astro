---
import { filesByLoader } from '../lib/assets.ts';
import type { ReleaseView } from '../lib/catalog.ts';
import { formatDate, loaderName, minecraftBandLabel } from '../lib/format.ts';
import { downloadPath, type SoftwareEntry } from '../server/software.ts';
import IconDownload from './IconDownload.astro';

interface Props {
  entry: SoftwareEntry;
  view: ReleaseView;
}

const { entry, view } = Astro.props;
const groups = view.state === 'ready' ? filesByLoader(view.modFiles) : [];
const stores =
  entry.data.kind === 'minecraft-mod'
    ? [
        { label: 'Modrinth', url: entry.data.modrinth },
        { label: 'CurseForge', url: entry.data.curseforge },
      ]
    : [];
---

<div class="picker">
  {
    view.state === 'ready' && groups.length > 0 ? (
      <form class="picker-form" method="get" action={downloadPath(entry.id)}>
        <fieldset class="loaders">
          <legend>1. Le loader de ton serveur</legend>
          <div class="loader-options">
            {groups.map(({ loader }) => (
              <label class="loader-option">
                <input type="radio" name="loader" value={loader} required />
                <span>{loaderName(loader)}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="versions">
          <p class="step">2. La version de Minecraft de ton serveur</p>
          <p class="hint">Choisis d’abord le loader.</p>
          {groups.map(({ loader, files }) => (
            <label class="version-field" data-loader={loader}>
              <span class="visually-hidden">Version de Minecraft pour {loaderName(loader)}</span>
              <select name={`mc-${loader}`}>
                {files.map((file) => (
                  <option value={file.bandId}>Minecraft {minecraftBandLabel(file.bandId)}</option>
                ))}
              </select>
            </label>
          ))}
        </div>
        <button class="gel submit" type="submit">
          <span class="submit-action">
            <IconDownload />
            Télécharger le mod
          </span>
          <span class="submit-facts numbers ready-facts">
            version {view.release.version}
            {view.release.publishedAt !== null && ` · publiée le ${formatDate(view.release.publishedAt)}`}
          </span>
          <span class="submit-facts waiting-facts" aria-hidden="true">
            Choisis d’abord le loader de ton serveur
          </span>
        </button>
      </form>
    ) : view.state === 'none' ? (
      <p>Aucune version n’est publiée pour l’instant.</p>
    ) : (
      <p>
        Le choix de version est indisponible pour l’instant.
        <a href={`${view.historyUrl}/latest`}>Prends le fichier directement sur GitHub</a> : son nom contient la
        version de Minecraft et le loader.
      </p>
    )
  }
  <p class="server-only">
    Ce mod s’installe seulement sur le serveur : les joueurs se connectent sans rien installer.
  </p>
  <ul class="stores">
    {
      stores.map((store) => (
        <li>
          <a class="pill store" href={store.url}>
            Aussi sur {store.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .picker {
    display: grid;
    gap: var(--space-3);
  }

  .picker-form {
    display: grid;
    gap: var(--space-3);
  }

  .loaders {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend,
  .step {
    margin-bottom: var(--space-1);
    padding: 0;
    font-weight: 700;
  }

  .loader-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    overflow: hidden;
    border: 1px solid rgb(11 42 68 / 0.25);
    border-radius: var(--radius-control);
    box-shadow: 0 3px 8px -3px rgb(6 48 74 / 0.35);
  }

  .loader-option {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .loader-option + .loader-option {
    border-left: 1px solid rgb(11 42 68 / 0.18);
  }

  .loader-option input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .loader-option span {
    display: block;
    padding: 0.6rem var(--space-2);
    background: linear-gradient(to bottom, var(--pill-0) 0%, var(--pill-1) 50%, var(--pill-2) 51%, var(--pill-1) 100%);
    font-weight: 600;
    text-align: center;
  }

  .loader-option input:checked + span {
    background: linear-gradient(to bottom, var(--gel-aqua-0) 0%, var(--gel-aqua-1) 49%, var(--gel-aqua-2) 50%, var(--gel-aqua-3) 100%);
    color: #ffffff;
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.4);
  }

  .loader-option input:focus-visible + span {
    outline: 3px solid var(--gel-aqua-1);
    outline-offset: -3px;
  }

  .versions {
    display: grid;
    gap: var(--space-1);
  }

  .hint {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(11 42 68 / 0.25);
    border-radius: 10px;
    background: var(--glass-strong);
    box-shadow: inset 0 2px 4px rgb(6 48 74 / 0.12);
    color: var(--ink);
    font: inherit;
  }

  .submit {
    display: grid;
    justify-items: start;
    gap: 0.2rem;
    width: 100%;
    border-radius: 18px;
    text-align: left;
  }

  .submit-action {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .submit-facts {
    font-size: var(--text-small);
    font-weight: 500;
  }

  @supports selector(:has(*)) {
    .version-field {
      display: none;
    }

    .picker-form:has(input[value='fabric']:checked) .version-field[data-loader='fabric'],
    .picker-form:has(input[value='forge']:checked) .version-field[data-loader='forge'],
    .picker-form:has(input[value='neoforge']:checked) .version-field[data-loader='neoforge'] {
      display: block;
    }

    .picker-form:has(input[name='loader']:checked) .hint {
      display: none;
    }

    .waiting-facts {
      display: none;
    }

    .picker-form:not(:has(input[name='loader']:checked)) .submit {
      background: var(--glass-strong);
      border-color: rgb(11 42 68 / 0.3);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6);
      color: var(--ink);
      text-shadow: none;
    }

    .picker-form:not(:has(input[name='loader']:checked)) .ready-facts {
      display: none;
    }

    .picker-form:not(:has(input[name='loader']:checked)) .waiting-facts {
      display: block;
    }
  }

  @supports not selector(:has(*)) {
    .hint,
    .waiting-facts {
      display: none;
    }
  }

  .server-only {
    font-weight: 700;
  }

  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .store {
    padding-left: 1rem;
  }
</style>
